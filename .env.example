# PostgreSQL (Supabase, Neon u otro proveedor)
# En despliegues serverless, DATABASE_URL debe usar el pool de transacciones.
DATABASE_URL="postgresql://usuario:password@pooler:6543/base?sslmode=require&pgbouncer=true"
# Conexión directa para migraciones de Prisma.
DIRECT_URL="postgresql://usuario:password@host:5432/base?sslmode=require"

# Genera al menos 32 bytes aleatorios: openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Vercel lo envía como Bearer token al cron diario de mantenimiento.
CRON_SECRET="genera-otro-secreto-aleatorio-de-al-menos-32-caracteres"

# Se usan exclusivamente al ejecutar el seed inicial.
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="cambia-esta-clave-por-una-muy-segura"

APP_URL="http://localhost:3000"

# Opcional: correo saliente
# Mantén false hasta configurar una contraseña SMTP nueva y exclusiva.
EMAIL_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Dominios autorizados para imágenes de producto, separados por comas.
# Si se deja vacío, no se aceptarán imágenes externas.
ALLOWED_IMAGE_HOSTS=""
