// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RolUsuario {
  ADMIN
}

enum EstadoPresupuesto {
  BORRADOR
  ENVIADO
  ACEPTADO
  RECHAZADO
}

model Usuario {
  id           String     @id @default(cuid())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario @default(ADMIN)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model IntentoLogin {
  clave           String    @id
  intentos        Int       @default(0)
  primerIntentoAt DateTime  @default(now())
  bloqueadoHasta  DateTime?
  updatedAt       DateTime  @updatedAt
}

model Cliente {
  id           String        @id @default(cuid())
  nombre       String
  email        String        @unique
  telefono     String?
  empresa      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  presupuestos Presupuesto[]

  @@index([nombre])
}

model Presupuesto {
  id              String            @id @default(cuid())
  numero          String            @unique
  publicToken     String            @unique
  publicEnabled   Boolean           @default(true)
  publicExpiresAt DateTime?
  cliente         Cliente           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  clienteId       String
  clienteNombre   String
  clienteEmail    String
  clienteTelefono String?
  clienteEmpresa  String?
  productos       Producto[]
  proveedor       String?
  notas           String?
  subtotal        Decimal           @db.Decimal(12, 2)
  ivaPorcentaje   Decimal           @default(21) @db.Decimal(5, 2)
  iva             Decimal           @db.Decimal(12, 2)
  total           Decimal           @db.Decimal(12, 2)
  estado          EstadoPresupuesto @default(BORRADOR)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([createdAt])
  @@index([estado])
  @@index([clienteId])
}

model ImagenProducto {
  id        String   @id @default(cuid())
  token     String   @unique
  mimeType  String
  datos     Bytes
  tamano    Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Producto {
  id              String      @id @default(cuid())
  presupuesto     Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  presupuestoId   String
  nombre          String
  descripcion     String
  caracteristicas String // JSON string con las características
  precio          Decimal     @db.Decimal(12, 2)
  cantidad        Int         @default(1)
  imagenUrl       String?
  createdAt       DateTime    @default(now())

  @@index([presupuestoId])
}

model Contador {
  id    String @id
  valor Int    @default(0)
}

model Configuracion {
  id            String   @id @default("principal")
  empresaNombre String
  nif           String?
  direccion     String?
  telefono      String?
  email         String?
  logoUrl       String?
  ivaDefault    Decimal  @default(21) @db.Decimal(5, 2)
  validezDias   Int      @default(30)
  updatedAt     DateTime @updatedAt
}
